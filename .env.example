# ==============================================================================
# ClauseLens Environment Configuration Template
# Copy to .env and configure for local development or production deployment.
# NEVER commit the actual .env file or real API keys to the repository.
# ==============================================================================

# Google Gemini API Credentials
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Models (confirmed live generation)
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Application Security & Authentication
JWT_SECRET=your_random_32_character_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & Networking
PORT=8008
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting (slowapi)
UPLOAD_RATE_LIMIT_PER_MINUTE=10/minute
RATE_LIMIT_PER_MINUTE=30/minute
MAX_UPLOAD_SIZE_BYTES=15728640

# Storage & Databases
DATABASE_URL=sqlite:///./clauselens.db
CHROMA_PERSIST_DIR=./chroma_data

# Frontend (Render Static Site / Vite Build)
# Required environment variable when building the frontend for Render:
VITE_API_URL=http://localhost:8008/api
# Production example for Render Static Site:
# VITE_API_URL=https://<your-backend-service>.onrender.com/api

